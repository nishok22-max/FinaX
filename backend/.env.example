# Copy to .env. Never commit real secrets.

# --- Chain / RPC ---
CHAIN_ID=42161
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL_FALLBACK=
FORK_BLOCK=0
RPC_TIMEOUT_SECONDS=20
RPC_MAX_RETRIES=3
POLL_INTERVAL_SECONDS=12

# On-chain addresses (Arbitrum One defaults; override for a fork/testnet).
VAULT_ADDRESS=
POOL_ADDRESSES_PROVIDER=0xa97684ead0e402dC232d5A977953DF7ECBaB3CDb
SWAP_ROUTER=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
QUOTER_V2=0x61fFE014bA17989E743c5F6cB21bF9697530B21e

# Chainlink feeds + oracle freshness (Phase 3 staleness gate, FR-17).
CHAINLINK_ETH_USD=0x639Fe6ab55C921f74e7fac1ee960C0B6293ba612
CHAINLINK_USDC_USD=0x50834F3163758fcC1Df9973b6e91f0F0F0434aD3
ORACLE_MAX_STALENESS_SECONDS=3600

# Keeper signer (TRIGGER only; bounded by borrower-signed params). Dev only — use KMS in prod.
KEEPER_PRIVATE_KEY=

# Circuit-breaker / worker tunables (Phase 5). All are read by app/config/settings.py;
# the values below are the defaults that apply when a key is omitted.
BREAKER_MAX_CONSECUTIVE_FAILURES=3
INFLIGHT_COOLDOWN_SECONDS=30
MAX_SIMULATION_BUMPS=3
AUTONOMOUS_ENABLED=true
# Kill-switch for the background monitor->decide->submit loop. Set false to run
# the API without any autonomous submission.
WORKER_ENABLED=true

# --- Local-fork demo aids (leave false everywhere else) ---
# When true, a protect request that carries no signature is signed server-side
# using the well-known anvil test mnemonic, so the console can drive the full
# path on a local fork. This is the ONLY situation in which a borrower key is
# handled by the backend; with DEMO_MODE=false an unsigned request is rejected
# on-chain at ECDSA.recover, which is the real non-custodial behaviour.
DEMO_MODE=false
