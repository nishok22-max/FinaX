# Copy to .env and fill in. Required for the Arbitrum One mainnet-fork tests.
# Get a free RPC URL from Alchemy / Infura / QuickNode / Ankr for Arbitrum One.
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional: pin a fork block for deterministic tests (recommended). Leave blank to use latest.
FORK_BLOCK=

# Only needed for the Deploy script (never commit a real key).
DEPLOYER_PRIVATE_KEY=
KEEPER_ADDRESS=
